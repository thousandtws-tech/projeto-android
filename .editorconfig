root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Longest existing line is 141 chars — keep the rule, with headroom.
max_line_length = 160
ktlint_code_style = ktlint_official
# @Composable functions are PascalCase by convention (BillsScreen, SgpCard).
ktlint_function_naming_ignore_when_annotated_with = Composable

# Disabled for the existing codebase (v1): the ktlint_official layout rules
# below conflict with the established formatting and fixing them would mean
# reformatting code owned by feature workstreams. Re-enable progressively.
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_annotation = disabled
ktlint_standard_blank-line-before-declaration = disabled
ktlint_standard_no-empty-first-line-in-class-body = disabled
ktlint_standard_spacing-between-declarations-with-comments = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_import-ordering = disabled

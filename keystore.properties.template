# Release signing credentials — NUNCA commitar o arquivo real.
#
# 1. Copie este arquivo para `keystore.properties` na raiz do projeto
#    (coberto por .gitignore) e preencha os valores reais.
# 2. Gere o keystore (uma vez) com:
#
#    keytool -genkeypair -v -keystore sgp-cliente-release.jks \
#      -alias sgp-cliente -keyalg RSA -keysize 4096 -validity 10950
#
# 3. `storeFile` pode ser caminho absoluto ou relativo à raiz do projeto.
#
# Sem `keystore.properties`, `:app:assemble*Release` gera APK/AAB não
# assinado — o build continua verde para devs e CI.

storeFile=sgp-cliente-release.jks
storePassword=TROQUE-ME
keyAlias=sgp-cliente
keyPassword=TROQUE-ME

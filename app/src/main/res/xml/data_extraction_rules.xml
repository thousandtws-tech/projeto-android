<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de extração/backup (API 31+). Mesma política do backup_rules.xml:
   a sessão persistida nunca sai do dispositivo, nem em device-to-device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/sgp_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/sgp_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
